# Groq API key for the agent nodes (free tier at console.groq.com)
GROQ_API_KEY=Your_Groq_API_Key_Here

# Sanity Context MCP endpoint URL (from your Sanity Dashboard, once Sanity
# Context has ingested your dataset)
SANITY_CONTEXT_MCP_URL=

# Standard Sanity project config, needed by the sanity/ Studio folder
SANITY_PROJECT_ID=Your_Sanity_Project_ID_Here
SANITY_DATASET=production
SANITY_API_TOKEN=Your_Sanity_API_Token_Here